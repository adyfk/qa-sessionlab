{
  "name": "qa-sessionlab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QA SessionLab — isolated per-tab sessions, role matrix, env presets, bug recorder and test data for QA engineers.",
  "license": "MIT",
  "author": "Adi Fatkhurozi",
  "homepage": "https://github.com/adyfk/qa-sessionlab#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adyfk/qa-sessionlab.git"
  },
  "bugs": {
    "url": "https://github.com/adyfk/qa-sessionlab/issues"
  },
  "keywords": [
    "chrome-extension",
    "qa",
    "testing",
    "multi-session",
    "multi-login",
    "rbac",
    "playwright",
    "mcp",
    "manifest-v3"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/build.mjs && node e2e/run.mjs",
    "bench:race": "node e2e/race.mjs",
    "ui:shots": "node e2e/ui-shots.mjs",
    "package": "node scripts/build.mjs && cd dist && zip -qr ../qa-sessionlab.zip . && echo 'qa-sessionlab.zip ready'",
    "check": "npm run typecheck && npm test && npm run build && node e2e/run.mjs && node e2e/audit.mjs && node e2e/mcp.mjs && node e2e/features.mjs",
    "e2e:mcp": "node e2e/mcp.mjs",
    "mcp": "node tools/mcp/qsl-mcp.mjs",
    "e2e:audit": "node e2e/audit.mjs",
    "e2e:features": "node e2e/features.mjs"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "preact": "^10.29.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
